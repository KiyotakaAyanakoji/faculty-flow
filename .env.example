# ==============================================================================
# Faculty Flow 2.0 - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure respective client/.env and server/.env files.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=faculty_flow_db
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_encryption_secret_here

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
