# ==============================================================================
# Faculty Flow 2.0 - Root Environment Configuration Template (Vercel & Railway)
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=development

# Frontend & CORS Origins (Set to your Vercel production domain in production)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false
VERCEL_PREVIEW_DOMAIN_PATTERN=^https:\/\/([a-z0-9-]+-)*faculty-flow.*\.vercel\.app$

# Cross-Site Cookie Configuration
# 'lax' for local dev / reverse proxy; 'none' for cross-domain Vercel + Railway
COOKIE_SAME_SITE=lax
COOKIE_SECRET=replace_with_at_least_32_characters_random_cookie_secret

# MySQL Database Configuration
# Railway MySQL provides MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=faculty_flow_db
DB_CONNECTION_LIMIT=10

# Authentication & Security Secrets
JWT_SECRET=faculty_flow_default_dev_secret_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Private Persistent Storage (Railway Volume Mount at /app/uploads in production)
EVENT_UPLOAD_DIR=

# Background Email Worker
RUN_NOTIFICATION_WORKER=true

# Email Notifications (Keep false until authorized SMTP credentials are provided)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Faculty Flow <noreply@facultyflow.local>"

# Frontend (Vercel Build-time Variable - Public)
# Leave empty for Vite dev proxy or set to Railway URL for cross-origin deployment
VITE_API_URL=
