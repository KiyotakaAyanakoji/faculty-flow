# ==============================================================================
# Faculty Flow 2.0 - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env (or respective server/.env and client/.env).
# In production (NODE_ENV=production), NEVER use development default values.
# All production secrets MUST be high-entropy random strings (>= 32 chars).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Allowed CORS Origin (Frontend URL). In production, set to your production domain (e.g., https://facultyflow.institution.edu)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. MySQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=faculty_flow_app
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=faculty_flow_db
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# 3. Authentication & Session Secrets
# ------------------------------------------------------------------------------
# In production, JWT_SECRET and COOKIE_SECRET must be at least 32 characters long.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_characters_random_hex_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_at_least_32_characters_random_cookie_secret

# ------------------------------------------------------------------------------
# 4. Persistent Document & Upload Storage
# ------------------------------------------------------------------------------
# Optional custom mount directory for private event PDF uploads.
# Defaults to server/uploads/events outside public web root if omitted.
# In containerized/cloud environments, point this to a persistent volume mount.
EVENT_UPLOAD_DIR=

# ------------------------------------------------------------------------------
# 5. Email Notifications & SMTP Configuration (Phase 7 & 8)
# ------------------------------------------------------------------------------
# Set EMAIL_ENABLED=true in production to deliver real emails via SMTP.
# When EMAIL_ENABLED=false, DevEmailTransport logs safe previews to console without external delivery.
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
# Set SMTP_SECURE=true for port 465 (SSL/TLS), false for port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="Faculty Flow <notifications@facultyflow.institution.edu>"

# ------------------------------------------------------------------------------
# 6. Frontend Build Configuration (client/.env)
# ------------------------------------------------------------------------------
# In production behind a reverse proxy, relative '/api' or your absolute API endpoint
VITE_API_URL=/api
