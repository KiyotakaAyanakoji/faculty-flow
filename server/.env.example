# ==============================================================================
# Faculty Flow 2.0 - Server Environment Configuration Template (Railway & Production)
# ==============================================================================

# Server & Runtime Configuration
# Note: On Railway, PORT is assigned automatically by the platform (e.g., 5000 / 8080).
PORT=5000
NODE_ENV=production

# CORS Allowed Origins
# Primary Vercel domain (e.g., https://faculty-flow.vercel.app or custom domain https://facultyflow.edu)
CLIENT_URL=https://faculty-flow.vercel.app
# Additional comma-separated origins (optional)
ALLOWED_ORIGINS=https://faculty-flow.vercel.app
# Enable support for Vercel preview branch deployments (e.g., https://faculty-flow-git-*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false
VERCEL_PREVIEW_DOMAIN_PATTERN=^https:\/\/([a-z0-9-]+-)*faculty-flow.*\.vercel\.app$

# Cookie Configuration for Cross-Site Deployment
# 'lax': Standard default when using same-origin reverse proxy or Vercel rewrites.
# 'none': Required when Vercel frontend calls Railway backend directly cross-origin (enforces Secure).
COOKIE_SAME_SITE=none
COOKIE_SECRET=replace_with_at_least_32_characters_random_cookie_secret

# MySQL Database Configuration
# When using Railway MySQL:
# Railway automatically supplies MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
# The server will automatically detect those variables if DB_* are not provided.
# For private Railway networking:
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=railway
DB_CONNECTION_LIMIT=10

# Authentication & Session Secrets (Must be >= 32 chars in production)
JWT_SECRET=replace_with_at_least_32_characters_random_hex_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Private Persistent Storage (Railway Volume Mount)
# IMPORTANT: Mount a Railway Persistent Volume at /app/uploads to prevent private PDF loss on redeploy.
EVENT_UPLOAD_DIR=/app/uploads

# Background Email Queue Worker
# Set to 'true' to run the worker embedded in the Express API instance (recommended for initial deploy).
# Set to 'false' if running a separate dedicated Railway worker service (npm run worker).
RUN_NOTIFICATION_WORKER=true

# Email Notifications & SMTP Configuration
# Keep EMAIL_ENABLED=false until an authorized SMTP provider and test recipient are configured.
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="Faculty Flow <notifications@facultyflow.institution.edu>"
