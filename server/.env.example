# ==============================================================================
# Faculty Flow 2.0 - Server Environment Configuration Template
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=faculty_flow_app
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=faculty_flow_db
DB_CONNECTION_LIMIT=10

# Authentication & Session Secrets (Must be >= 32 chars in production)
JWT_SECRET=replace_with_at_least_32_characters_random_hex_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_at_least_32_characters_random_cookie_secret

# Persistent Document & Upload Storage (Mount point for private PDFs)
EVENT_UPLOAD_DIR=

# Email Notifications & SMTP Configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="Faculty Flow <notifications@facultyflow.institution.edu>"
